# 복사해서 .env.local 로 쓴다. ⛔실제 값을 이 파일에 적지 않는다.

# ── 데이터베이스 (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>   # 서버 전용. 클라이언트에 노출 금지

# ── LLM (단가 분석에만 쓴다. ⛔매칭에는 쓰지 않는다)
OPENAI_API_KEY=<api key>

# ── 결제 (⛔반드시 sandbox 키. 실결제 키를 넣지 않는다)
TOSS_CLIENT_KEY=test_ck_<...>
TOSS_SECRET_KEY=test_sk_<...>

# ── 소셜 로그인
OAUTH_GOOGLE_CLIENT_ID=<client id>
OAUTH_GOOGLE_CLIENT_SECRET=<client secret>

# ── 스토리지 (프로필 이미지)
STORAGE_BUCKET=instructor-photos

# ── 분석 (3-2 실무 프로젝트 입력)
# 🔴학습 키 파일(~/.claude/secrets/amplitude-mission9.env)의 변수명은 VITE_ 다 — 미션8이 Vite 였다.
#   그대로 복사하면 Next 에서 안 읽힌다. 반드시 NEXT_PUBLIC_ 으로 바꿔 넣는다.
# ⛔사업 Amplitude 키를 넣지 않는다 — 평가 트래픽을 사업 측정축에 섞지 않는다.
NEXT_PUBLIC_AMPLITUDE_API_KEY=<학습 전용 키>
