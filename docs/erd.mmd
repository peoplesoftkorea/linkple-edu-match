  edu_reviews {
    uuid id PK
    text subject "평가 방향"
    uuid instructor_id FK
    integer rating "별점 1-5"
    text_arr tags "태그"
  }
  edu_notifications {
    uuid id PK
    text audience "수신 대상"
    text kind "트리거 5종"
    timestamptz read_at "읽음"
    timestamptz sent_at "발송"
  }
