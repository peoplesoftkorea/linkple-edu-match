  edu_cohorts {
    uuid id PK
    uuid order_id FK
    text title "기수"
    date starts_on "개강"
  }
  edu_sessions {
    uuid id PK
    uuid cohort_id FK
    integer seq "회차 번호"
    date held_on "실시일"
  }
  edu_org_orders {
    uuid id PK
    text order_no "발주 번호"
    text org_name "발주 기업"
