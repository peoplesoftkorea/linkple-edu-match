    text program_slug "과정"
    text status "상태 머신"
  }
  edu_instructors {
    uuid id PK
    text name "강사"
    text_arr expertise "전문 분야 K축"
    text_arr regions "출강 권역 L축"
    boolean contactable "연락 가능"
  }
  edu_match_runs {
    uuid id PK
    uuid order_id FK
    jsonb weights "K S A C L 가중치"
    timestamptz created_at
  }
  edu_match_scores {
    uuid id PK
    uuid run_id FK
    uuid instructor_id FK
    numeric total "종합 점수"
    jsonb axes "축별 점수"
  }
  edu_instructor_engagements {
    uuid id PK
    uuid instructor_id FK
    uuid session_id FK
