  }
  edu_contracts {
    uuid id PK
    uuid engagement_id FK
    text status "생성·서명대기·체결·무효"
    text template_rev "문안 판본"
    timestamptz sign_token_expires_at
  }
  edu_contract_signatures {
    uuid id PK
    uuid contract_id FK
    text party "당사 또는 강사"
    text signer_name "서명자"
    timestamptz signed_at
  }
